{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-note-dashboard",
  "account_id": "c35a60faec65241511d7cb5dcb83a0a3",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "call-note-analytics",
      "database_id": "f1dc67de-485b-477d-b79d-a3b6ec057c90",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "slyapustin.cloudflareaccess.com",
    "ACCESS_AUD": "eb807edf904ed35718bcf9def85790e66b9fa2a270de4a2e0e7ed1e70322ad52",
    "DASHBOARD_ONLY": "true"
  }
}
